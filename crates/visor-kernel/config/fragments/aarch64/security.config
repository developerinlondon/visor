# Visor kernel security hardening (aarch64).
#
# Principle: minimize guest kernel attack surface. This kernel runs
# untrusted container workloads — every unnecessary subsystem is a
# potential escape vector.

# ── Stack initialization ──────────────────────────────────────
# Zero-init all stack variables to prevent info leaks.
# CONFIG_INIT_STACK_NONE is not set
CONFIG_INIT_STACK_ALL_ZERO=y

# ── Disable nested virtualization ─────────────────────────────
# This is a GUEST kernel. KVM host support is a massive attack surface
# with zero benefit — guests should not run nested VMs.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set

# ── Stack protector ──────────────────────────────────────────
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# ── Seccomp (syscall filtering) ──────────────────────────────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ── LSM ──────────────────────────────────────────────────────
CONFIG_LSM="landlock,yama,loadpin,safesetid,integrity"

# ── ARM64 CPU mitigations ────────────────────────────────────
# Enable all available ARM64-specific CPU vulnerability mitigations.
# ARM64 has different vulnerabilities than x86_64 (no MDS, TAA, L1TF).
CONFIG_CPU_MITIGATIONS=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_1024718=y
