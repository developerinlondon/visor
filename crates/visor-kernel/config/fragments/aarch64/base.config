# Visor kernel base configuration (aarch64).
#
# Fundamental identity: 64-bit ARM virtual machine guest microVM with
# no loadable modules. Uses Device Tree (FDT) for device discovery.
# Kernel version: mainline Linux 7.0-rc1 (torvalds/linux)

# ── Architecture ──────────────────────────────────────────────
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HZ_250=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_EXPERT=y

# ── ARM virtual machine platform ─────────────────────────────
# ARCH_VIRT selects the generic ARM64 virtual machine platform,
# which provides GICv3 interrupt controller and generic timer.
CONFIG_ARCH_VIRT=y

# ── Identity ──────────────────────────────────────────────────
CONFIG_DEFAULT_HOSTNAME="visor"
CONFIG_DEFAULT_INIT=""
CONFIG_LOCALVERSION="-visor"

# ── No loadable modules — everything built-in ────────────────
# CONFIG_MODULES is not set

# ── Device Tree (FDT for VM device discovery) ────────────────
# The VMM generates a flattened device tree describing memory,
# CPUs, interrupt controller, and virtio-mmio devices.
CONFIG_OF=y
CONFIG_OF_FLATTREE=y

# ── PSCI (power state coordination interface) ────────────────
# Required for CPU bring-up (SMP boot), idle, and shutdown on
# ARM64 virtual machines. The hypervisor traps PSCI calls.
CONFIG_ARM_PSCI_FW=y

# ── Timer ─────────────────────────────────────────────────────
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set
CONFIG_HIGH_RES_TIMERS=y
CONFIG_ARM_ARCH_TIMER=y

# ── Logging ───────────────────────────────────────────────────
CONFIG_LOG_BUF_SHIFT=17
CONFIG_PRINTK=y

# ── PCI (may be needed by subsystems) ────────────────────────
CONFIG_PCI=y

# ── Namespaces + cgroups (container support inside VM) ────────
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y

# ── Filesystem ────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
