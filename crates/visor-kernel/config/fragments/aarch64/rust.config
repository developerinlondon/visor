# Visor kernel features (aarch64).
#
# Note: CONFIG_RUST is not enabled for aarch64 yet. Rust kernel
# support requires a matching LLVM/rustc toolchain in the build
# environment. Enable when the aarch64 build infrastructure
# includes the required Rust components (rustc, bindgen, rust-src).
# CONFIG_RUST is not set

# ── XFS with autonomous self-healing (xfs_healer) ───────────
# Linux 7.0 introduces real-time health monitoring and automatic
# metadata repair via the xfs_healer daemon.
CONFIG_XFS_FS=y
CONFIG_XFS_QUOTA=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_XFS_ONLINE_SCRUB=y
CONFIG_XFS_ONLINE_REPAIR=y

# ── New VFS mount API (open_tree / move_mount / fsopen) ──────
CONFIG_TMPFS=y
CONFIG_SHMEM=y

# ── Memory failure recovery (hardware error self-healing) ────
CONFIG_MEMORY_FAILURE=y
