# Visor kernel features and Linux 7.0 enhancements.
#
# Note: CONFIG_RUST is disabled. While Linux 7.0 makes Rust a first-class
# citizen, visor has no Rust kernel drivers. Enabling it adds ~5MB to the
# binary and requires rustc + bindgen + rust-src in the build environment.
# Re-enable when Rust virtio drivers land in mainline and we adopt them.
# CONFIG_RUST is not set

# ── XFS with autonomous self-healing (xfs_healer) ───────────
# Linux 7.0 introduces real-time health monitoring and automatic
# metadata repair via the xfs_healer daemon. This enables:
#   - Live detection of metadata corruption, media errors, I/O errors
#   - Automatic targeted repair without unmount
#   - Health events streamed to userspace via anonymous fd
CONFIG_XFS_FS=y
CONFIG_XFS_QUOTA=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_XFS_ONLINE_SCRUB=y
CONFIG_XFS_ONLINE_REPAIR=y

# ── New VFS mount API (open_tree / move_mount / fsopen) ──────
# Enhanced mount namespace support — open_tree_namespace allows
# fine-grained mount propagation control for container workloads.
# These are built-in to VFS core (no separate config), but require:
CONFIG_TMPFS=y
CONFIG_SHMEM=y

# ── Memory failure recovery (hardware error self-healing) ────
CONFIG_MEMORY_FAILURE=y
