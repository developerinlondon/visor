# Visor kernel — intentional design decisions.
#
# These options are DELIBERATELY disabled. Each has a rationale.
# Do not "fix" these without discussing the tradeoff.

# ── IPv6 ──────────────────────────────────────────────────────
# Disabled to reduce attack surface. Visor microVMs use IPv4-only
# networking. Re-enable if workloads require IPv6 sockets (e.g.
# Node.js binding to ::1, Go net.Listen on IPv6).
# CONFIG_IPV6 is not set

# ── Time namespaces ───────────────────────────────────────────
# Disabled because visor manages time for guest VMs via KVM
# paravirt clock. Container runtimes inside the VM that need
# time isolation (e.g. nested Docker) would require this.
# CONFIG_TIME_NS is not set

# ── BPF ───────────────────────────────────────────────────────
# Keep the BPF JIT disabled to reduce attack surface, but nested
# container runtimes such as BuildKit's runc path require the BPF
# syscall interface for cgroup device filters.
CONFIG_BPF_SYSCALL=y
# CONFIG_BPF_JIT is not set
