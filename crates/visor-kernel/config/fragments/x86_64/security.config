# Visor kernel security hardening.
#
# Principle: minimize guest kernel attack surface. This kernel runs
# untrusted container workloads — every unnecessary subsystem is a
# potential escape vector.

# ── Stack initialization ──────────────────────────────────────
# Zero-init all stack variables to prevent info leaks.
# CONFIG_INIT_STACK_NONE is not set
CONFIG_INIT_STACK_ALL_ZERO=y

# ── Machine Check Exceptions ─────────────────────────────────
# Without MCE, hardware errors cause silent memory corruption.
CONFIG_X86_MCE=y

# ── Opt-in nested virtualization support ──────────────────────
# Builder guests may need /dev/kvm for qemu/libvirt/image tooling.
# Keep host-side KVM support built-in because modules are disabled, but
# rely on the runtime's guest-virtualization policy to hide VMX/SVM from
# ordinary workload VMs unless nested virtualization is explicitly enabled.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
# CONFIG_KVM_SMM is not set
# CONFIG_KVM_HYPERV is not set
# CONFIG_KVM_MAX_NR_VCPUS is not set

# ── Stack protector ──────────────────────────────────────────
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# ── Seccomp (syscall filtering) ──────────────────────────────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ── LSM ──────────────────────────────────────────────────────
CONFIG_LSM="landlock,yama,loadpin,safesetid,integrity"

# ── CPU mitigations (all enabled) ────────────────────────────
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_SRBDS=y
