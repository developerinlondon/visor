# Visor kernel base configuration.
#
# Fundamental identity: 64-bit KVM guest microVM with no loadable modules.
# Kernel version: mainline Linux 7.0-rc1 (torvalds/linux)

# ── Architecture ──────────────────────────────────────────────
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HZ_250=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_EXPERT=y

# ── Identity ──────────────────────────────────────────────────
CONFIG_DEFAULT_HOSTNAME="visor"
CONFIG_DEFAULT_INIT=""
CONFIG_LOCALVERSION="-visor"

# ── No loadable modules — everything built-in ────────────────
# CONFIG_MODULES is not set

# ── KVM guest paravirtualization ─────────────────────────────
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_TIME_ACCOUNTING=y
CONFIG_PARAVIRT_CLOCK=y

# ── Timer ─────────────────────────────────────────────────────
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set
CONFIG_HIGH_RES_TIMERS=y

# ── Compression ───────────────────────────────────────────────
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_ZSTD=y

# ── Logging ───────────────────────────────────────────────────
CONFIG_LOG_BUF_SHIFT=17
CONFIG_PRINTK=y

# ── ACPI (required for device/CPU discovery) ──────────────────
CONFIG_ACPI=y
# Reduced-hardware mode — our FADT leaves PM1a event/control block addresses
# zeroed, so the kernel must not try to initialize legacy fixed ACPI events.
CONFIG_ACPI_REDUCED_HARDWARE_ONLY=y

# ── PCI (required by ACPI subsystem for operation region handlers) ──
# The VMM uses MMIO transport (not PCI), but the kernel ACPI subsystem
# needs PCI support registered to avoid AE_BAD_PARAMETER during table load.
CONFIG_PCI=y

# ── Namespaces + cgroups (container support inside VM) ────────
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y

# ── Filesystem ────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
