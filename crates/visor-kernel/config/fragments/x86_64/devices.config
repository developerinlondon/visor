# Visor kernel device configuration.
#
# The VMM (visor-machine) exposes these virtual devices:
#   - Serial UART 16550 (COM1) via PIO — devices/serial.rs
#   - virtio-blk via MMIO transport    — devices/block.rs
#   - virtio-net via MMIO transport    — devices/net.rs
#   - virtio-vsock via MMIO transport  — devices/vsock.rs
#
# The guest init (visor-init) requires:
#   - TCP/IP stack for networking      — network.rs
#   - Unix sockets for IPC             — general POSIX requirement
#   - vsock for host↔guest RPC         — agent.rs
#
# IMPORTANT: kconfig has silent dependency chains. If a prerequisite
# is missing, downstream options are silently dropped by olddefconfig.
# Always include the full chain: CONFIG_NET → CONFIG_NETDEVICES → CONFIG_VIRTIO_NET.

# ── VirtIO core + MMIO transport (our transport) ─────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# ── VirtIO block (our disk backend) ──────────────────────────
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV=y

# ── Serial UART (our console) ────────────────────────────────
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ── Networking stack (prerequisite for all net/vsock devices) ──
# CONFIG_NET is the master switch. Without it, everything below
# (INET, NETDEVICES, VIRTIO_NET, VSOCKETS, UNIX) is silently dropped.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_NETDEVICES=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_POSIX_MQUEUE=y

# ── VirtIO net (guest NIC — devices/net.rs) ────────────────
CONFIG_VIRTIO_NET=y

# ── VirtIO vsock (host↔guest RPC — devices/vsock.rs) ──────
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# ── VirtIO IOMMU (needed for DMA) ────────────────────────────
CONFIG_VIRTIO_IOMMU=y

# ══ DISABLED: VMM does NOT implement these ═══════════════════

# ── VirtIO PCI transport (VMM uses MMIO only) ────────────────
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_PCI_LEGACY is not set
# CONFIG_VIRTIO_PCI_LIB is not set
# CONFIG_VIRTIO_PCI_LIB_LEGACY is not set
# CONFIG_VIRTIO_PCI_ADMIN_LEGACY is not set

# ── Stub virtio devices (no VMM backend) ─────────────────────
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_HW_RANDOM_VIRTIO is not set

# ── EFI (VMM does direct kernel boot, no UEFI firmware) ──────
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# CONFIG_EFI_ESRT is not set
# CONFIG_EFI_EARLYCON is not set
# CONFIG_EFI_CUSTOM_SSDT_OVERLAYS is not set
# CONFIG_EFI_RUNTIME_WRAPPERS is not set
# CONFIG_EFI_DXE_MEM_ATTRIBUTES is not set
# CONFIG_EFIVAR_FS is not set

# ── NVMe (VMM uses virtio-blk) ───────────────────────────────
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_MULTIPATH is not set

# ── VFIO (no PCI passthrough) ────────────────────────────────
# CONFIG_VFIO is not set
# CONFIG_VFIO_PCI is not set
# CONFIG_VFIO_PCI_CORE is not set

# ── Hyper-V (we run on KVM, not Hyper-V) ─────────────────────
# CONFIG_HYPERV is not set
# CONFIG_HYPERV_TIMER is not set
# CONFIG_HYPERV_IOMMU is not set
