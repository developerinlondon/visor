# Visor kernel performance and bloat reduction.
#
# Strip unnecessary subsystems to reduce kernel size, memory use,
# and boot time. Every option here either saves memory or removes
# code that serves no purpose in a microVM.

# ── CPU frequency scaling (host controls clock, useless in VM) ─
# SCHED_MC_PRIO `select CPU_FREQ` and `select X86_AMD_PSTATE` via
# kconfig `select` — must disable it first to break the chain.
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_X86_AMD_PSTATE is not set

# ── Memory hotplug (fixed memory size) ────────────────────────
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_MEMORY_HOTREMOVE is not set

# ── Device-mapper multipath (simple virtio-blk, no multipath) ─
# CONFIG_DM_MULTIPATH is not set

# ── ZRAM compressed swap (questionable in small microVMs) ─────
# CONFIG_ZRAM is not set

# ── Debug flags (disable for production) ──────────────────────
# CONFIG_PCI_DEBUG is not set
# CONFIG_JBD2_DEBUG is not set
# CONFIG_FW_LOADER_DEBUG is not set

# ── Legacy udev helper (deprecated, use netlink) ─────────────
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
