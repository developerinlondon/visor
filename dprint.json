{
    "lineWidth": 100,
    "indentWidth": 4,
    "useTabs": false,
    "newLineKind": "lf",
    "includes": ["**/*.{rs,toml,json,md}"],
    "excludes": ["target/", "kernel/"],
    "plugins": [
        "https://plugins.dprint.dev/toml-0.6.4.wasm",
        "https://plugins.dprint.dev/json-0.19.4.wasm",
        "https://plugins.dprint.dev/markdown-0.17.8.wasm"
    ],
    "markdown": {
        "lineWidth": 100
    },
    "toml": {
        "lineWidth": 100
    },
    "json": {
        "lineWidth": 100
    }
}
